uq:coverage_probability_value a owl:DatatypeProperty ;
    rdfs:label "coverage_probability_value" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
