<https://ce-rise-models.codeberg.page/uncertainty-quantification/EvaluationTypeEnum#data_quality_derived> a owl:Class ;
    rdfs:label "data_quality_derived" ;
    rdfs:subClassOf uq:EvaluationTypeEnum ;
